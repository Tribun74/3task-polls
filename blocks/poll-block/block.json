{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tpoll/poll",
    "version": "1.0.4",
    "title": "3task Polls",
    "category": "widgets",
    "icon": "chart-bar",
    "description": "Show a poll, star rating or up/down voting from 3task Polls.",
    "keywords": [
        "poll",
        "vote",
        "survey",
        "rating",
        "umfrage"
    ],
    "textdomain": "3task-polls",
    "attributes": {
        "pollId": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "className": true
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css"
}
