#. Plugin Name of the plugin
#: 3task-polls.php
msgid "3task Polls: Cookieless Polls, Star Rating & Voting"
msgstr "3task Polls: Umfragen ohne Cookie, Sternebewertung und Abstimmung"

#. Plugin URI of the plugin
#: 3task-polls.php
msgid "https://wordpress.org/plugins/3task-polls/"
msgstr "https://wordpress.org/plugins/3task-polls/"

#. Description of the plugin
#: 3task-polls.php
msgid "Polls, star ratings, reactions and up/down voting that stay on your own server. Feedback below posts. No third-party service, no tracking cookie, IP addresses only as salted hashes. Gutenberg block and shortcode."
msgstr "Umfragen, Sternebewertungen, Reaktionen und Daumen-Abstimmungen, die auf deinem eigenen Server bleiben. Feedback unter Beiträgen. Kein Fremddienst, kein Tracking-Cookie, IP-Adressen nur als gesalzene Hashes. Block und Shortcode."

#. Author of the plugin
#: 3task-polls.php
msgid "3task"
msgstr "3task"

#. Author URI of the plugin
#: 3task-polls.php
msgid "https://www.3task.de"
msgstr "https://www.3task.de"

